# CS2 Map Analyze – nastavení. SETUP.bat tento soubor vyplní za tebe.
# Soubor .env NIKOMU neposílej – obsahuje tvoje klíče.

# Tvoje přezdívka na FACEIT (podle ní aplikace pozná tvůj tým)
FACEIT_NICKNAME=SEM_PREZDIVKA
# Vyplní SETUP automaticky po ověření přezdívky (stabilní ID, přezdívka se může změnit)
FACEIT_PLAYER_ID=

# Klíč k FACEIT Data API (zdarma): developers.faceit.com -> App Studio -> API keys -> "Server side"
FACEIT_API_KEY=SEM_KLIC

# Token k FACEIT Downloads API (automatické stahování dem). Vyžaduje schválení FACEITem:
# https://fce.gg/downloads-api-application  – dokud ho nemáš, nech prázdné.
FACEIT_DOWNLOAD_TOKEN=

# --- volitelné ---
PORT=8765
# Kolik GB smí zabírat stažená dema (po zpracování se stejně mažou)
MAX_DEMO_DISK_GB=5
# 1 = ponechat stažená dema na disku (jinak se po zpracování smažou, pozice zůstanou v cache)
KEEP_DEMOS=0
DOWNLOAD_WORKERS=4
# 0 = automaticky podle procesoru
PARSE_WORKERS=0
